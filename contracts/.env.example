# Copy to contracts/.env. Never commit the real file. Keys go through `cast wallet import`, not here.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Parent name to register, without .eth. Must be free.
ENS_PARENT_LABEL=

# Optional. Defaults to the CRE mock forwarder used by simulation.
# Production: 0xF8344CFd5c43616a4366C34E3EEE75af79a74482
CRE_FORWARDER=

# Optional. Addresses of the seeded robots. If unset, addresses nobody controls are derived from the label.
ROBOT_01=
ROBOT_02=
ROBOT_03=
# Optional. Seed lease length, default 30 days.
LEASE_SECONDS=

# Optional, for DeployAnchor. Must be the ZEROG_PRIVATE_KEY wallet. Default: the deploying wallet.
ANCHOR_OWNER=
